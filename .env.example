# Copy to .env and fill in. .env is gitignored — keep it that way.

# ── Cloudflare dashboard push ────────────────────────────────────────────────
CLOUDFLARE_PUSH_URL=https://dropshipping.battersea-dynamics.workers.dev/api/push
# Must match the Worker secret. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Then set it on the Worker:  wrangler secret put PUSH_SECRET
PUSH_SECRET=

# ── Telegram alerts ──────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── eBay Browse API (price + saturation lookups) ─────────────────────────────
# https://developer.ebay.com → your app → Production keyset
EBAY_APP_ID=
EBAY_CERT_ID=

# ── TikTok (currently unused by the scanner) ─────────────────────────────────
# The TikTok scanner drives Creative Center with Playwright and needs no auth.
# These are kept only for future TikTok Shop / Ads API work.
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_ACCESS_TOKEN=

# ── Google Trends via SerpAPI (not enabled) ──────────────────────────────────
SERPAPI_KEY=
